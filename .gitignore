# ==========================================================
# .gitignore —— Git 的「忽略清单」
# 写在这里的文件/文件夹，Git 不会跟踪、也不会提交到仓库
# 规则说明：# 开头是注释，/ 结尾表示目录，* 是通配符
# ==========================================================

# ---------- 操作系统自动生成的垃圾文件 ----------
.DS_Store          # macOS 桌面服务的隐藏文件
Thumbs.db          # Windows 缩略图缓存
desktop.ini        # Windows 文件夹配置
ehthumbs.db

# ---------- 编辑器 / IDE 的个人配置 ----------
.vscode/           # VS Code（保留 settings.json 可自行取消忽略）
.idea/             # PyCharm / IntelliJ
*.swp
*.swo
*~

# ---------- Python ----------
__pycache__/       # Python 运行时字节码缓存
*.py[cod]
*.egg-info/
.venv/             # 虚拟环境（体积大，绝不上传）
venv/
env/
.pytest_cache/
.ipynb_checkpoints/  # Jupyter 自动检查点

# ---------- Node.js / 前端 ----------
node_modules/      # 依赖包目录（体积巨大，用 npm install 可重建）
npm-debug.log*
yarn-debug.log*
yarn-error.log*
dist/
build/

# ---------- C / C++ / Java 编译产物 ----------
*.class
*.jar
*.o
*.obj
*.exe
*.dll

# ---------- 临时文件与日志 ----------
*.log
*.tmp
*.temp
*.bak
*.orig
temp/
tmp/

# ---------- 敏感信息（安全红线，务必忽略）----------
.env               # 环境变量文件，常含账号密码
.env.local
*.key
*.pem
secrets.*
credentials.json

# ---------- 实验数据（按需自行调整）----------
# 大体积数据集不要进仓库，建议放网盘并在 README 里附链接
# *.csv
# *.zip
